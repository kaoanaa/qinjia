{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^qj-(.*)": "@/components/qj-$1/qj-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/today/index", "style": { "navigationBarTitleText": "今日推荐" } },
    { "path": "pages/speedup/index", "style": { "navigationBarTitleText": "加速脱单" } },
    { "path": "pages/activity/index", "style": { "navigationBarTitleText": "精彩活动" } },
    { "path": "pages/message/index", "style": { "navigationBarTitleText": "消息" } },
    { "path": "pages/mine/index", "style": { "navigationBarTitleText": "我的" } }
  ],
  "tabBar": {
    "color": "#7A7A7A",
    "selectedColor": "#E64340",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/today/index", "text": "今日推荐" },
      { "pagePath": "pages/speedup/index", "text": "加速脱单" },
      { "pagePath": "pages/activity/index", "text": "活动" },
      { "pagePath": "pages/message/index", "text": "消息" },
      { "pagePath": "pages/mine/index", "text": "我的" }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "完美亲家",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F6F6F6"
  }
}
